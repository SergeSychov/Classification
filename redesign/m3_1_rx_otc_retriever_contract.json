  },
  "retry_policy": {
    "logical_search_query_count_max": 8,
    "transport_retry_attempt_count_max_per_logical_query": 2,
    "fetched_page_count_max": 4,
    "max_attempts_per_query_string": 3,
    "accounting": {
      "logical_search_query_count": "counts distinct executed ladder queries; transport retries do not increment this; alias search_query_count",
      "transport_retry_attempt_count": "physical retries of the same logical query; max 2 per logical query (initial + 2 retries = 3 attempts)",
      "fetched_page_count": "fetched candidate pages after source/domain filter; max 4",
      "applies_from": "M3.2b+",
      "m3_2a_skeleton": "HTTP forbidden; counters unused"
    },
    "backoff_seconds": [1, 2, 4],
    "jitter_pct": 30,
    "query_kind_progression": ["grls_primary", "official_instruction", "support_card"],
    "retryable": [
      "transport_timeout",
      "HTTP_429",
      "HTTP_5xx",
      "transient_parser_failure",
