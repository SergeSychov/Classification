    "proposed_rx_otc_evidence_tier",
    "proposed_rx_otc_status",
    "proposed_rx_otc_run_id"
  ],
  "code_nodes": [
    {
      "node_name": "Run — Init Constants",
      "purpose": "Attach versions, enums, M2 exclusion set, query budget, isolation flags. Do not INSERT classification_runs in M3.2a.",
      "input_contract": ["trigger_item"],
      "output_contract": ["constants", "workflow_version", "run_id", "stage", "isolation"],
      "uses_item_json_spread": true,
      "error_behavior": "fail item with E_INPUT_IDENTITY if constants missing"
    },
    {
      "node_name": "Rx — Validate Input Contract",
      "purpose": "Require product_id and usable identity text.",
      "input_contract": ["product_id", "normalized_text_full"],
      "output_contract": ["input_validation_passed", "input_reject_reason"],
      "uses_item_json_spread": true,
      "error_behavior": "fail closed → rejected / E_INPUT_IDENTITY; still emit audit row"
    },
    {
      "node_name": "Rx — Build Product Identity",
      "purpose": "Deterministic identity fields. Deduplicate noisy Norm locally. Do not mutate normalized_text.",
      "input_contract": ["normalized_text_full", "optional structured dims"],
      "output_contract": ["rx_otc_identity_*", "rx_otc_brand_norm", "rx_otc_form_norm", "rx_otc_strength_norm", "rx_otc_pack_norm", "rx_otc_manufacturer_norm"],
      "uses_item_json_spread": true,
      "error_behavior": "unusable identity → rejected / E_INPUT_IDENTITY"
    },
    {
      "node_name": "Rx — M2 Non-drug Exclusion Gate",
      "purpose": "Stop 13 applied M2 BAS/Other IDs with audit-only not_applicable.",
      "input_contract": ["product_id", "constants.m2_excluded_product_ids"],
      "output_contract": ["m2_gate", "outcome"],
      "uses_item_json_spread": true,
      "error_behavior": "exclude is a successful audit outcome, never throws"
    },
    {
      "node_name": "Q1 — Build GRLS Query",
      "purpose": "Emit Q1 templates with query_kind=grls_primary and reason. Never MNN-only if brand exists.",
      "input_contract": ["identity fields"],
      "output_contract": ["query_plan", "current_query", "query_kind", "reason"],
      "uses_item_json_spread": true,
      "error_behavior": "missing brand → unresolved, do not MNN-only"
    },
    {
      "node_name": "Q1 — Fetch Stub",
      "purpose": "M3.2a stub: no HTTP. Later Search/Fetch P1 GRLS. Fetch only URLs that passed source/domain filter; do not fetch P3 landings as SKU evidence unless they resolve to a P1 card. Counts toward max_fetched_candidate_pages_per_eligible_sku=4.",
      "input_contract": ["current_query"],
      "output_contract": ["http_status=0", "stubbed=true", "retrieved_candidates=[]"],
      "uses_item_json_spread": true,
      "error_behavior": "stub always succeeds with empty hits"
    },
    {
      "node_name": "Q1 — Parse P1",
      "purpose": "Classify source_type/tier; extract title/excerpt/URL. LLM summary is not excerpt.",
      "input_contract": ["fetch payload"],
      "output_contract": ["retrieved_candidates"],
      "uses_item_json_spread": true,
      "error_behavior": "transient parse → E_PARSE_TRANSIENT; empty → E_SOURCE_NOT_FOUND advance layer"
    },
    {
      "node_name": "Rx — Validate P1 Evidence",
      "purpose": "Identity grade, explicit status, validation_passed for P1.",
      "input_contract": ["retrieved_candidates", "identity"],
      "output_contract": ["validated_evidence", "tier1_accepted", "best_p1", "reject_reason"],
      "uses_item_json_spread": true,
      "error_behavior": "P3 or no status → validation_passed=false"
    },
    {
      "node_name": "Q2 — Build Official Instruction Query",
      "purpose": "Emit Q2 templates if Tier 1 not accepted after Q1.",
      "input_contract": ["identity", "q1_outcome"],
      "output_contract": ["query_plan", "current_query", "query_kind=official_instruction"],
      "uses_item_json_spread": true,
      "error_behavior": "same as Q1 builder"
    },
    {
      "node_name": "Q2 — Fetch Stub",
      "purpose": "M3.2a stub for official instruction fetch.",
      "input_contract": ["current_query"],
      "output_contract": ["stubbed empty hits"],
      "uses_item_json_spread": true,
      "error_behavior": "stub always succeeds"
    },
    {
      "node_name": "Q2 — Parse Official",
      "purpose": "Parse official instruction / MAH pages.",
      "input_contract": ["fetch payload"],
      "output_contract": ["retrieved_candidates"],
      "uses_item_json_spread": true,
      "error_behavior": "same as Q1 parse"
    },
    {
      "node_name": "Rx — Validate P1 Official Evidence",
      "purpose": "Validate Q2 P1 candidates.",
      "input_contract": ["retrieved_candidates", "identity", "prior_validated_evidence"],
      "output_contract": ["validated_evidence", "tier1_accepted"],
      "uses_item_json_spread": true,
      "error_behavior": "same as P1 validate"
    },
    {
      "node_name": "Q3 — Build Support Query",
      "purpose": "Emit Q3 RLS/Vidal templates. P2 only.",
      "input_contract": ["identity", "q1_q2_outcome"],
      "output_contract": ["query_plan", "current_query", "query_kind=support_card"],
      "uses_item_json_spread": true,
      "error_behavior": "same as Q1 builder"
    },
    {
      "node_name": "Q3 — Fetch Stub",
      "purpose": "M3.2a stub for P2 fetch.",
      "input_contract": ["current_query"],
      "output_contract": ["stubbed empty hits"],
      "uses_item_json_spread": true,
      "error_behavior": "stub always succeeds"
    },
    {
      "node_name": "Q3 — Parse Support",
      "purpose": "Parse RLS/Vidal/pharmacy cards. Generic MNN paths → P3.",
      "input_contract": ["fetch payload"],
      "output_contract": ["retrieved_candidates"],
      "uses_item_json_spread": true,
      "error_behavior": "same as Q1 parse"
    },
    {
      "node_name": "Rx — Validate P2 Evidence",
      "purpose": "P2 may only produce tier_2_supported_soft_signal. Sets candidate_rx_otc_value; never sets final_rx_otc_value. Not hard routing, snapshot, or attr merge.",
      "input_contract": ["retrieved_candidates", "identity"],
      "output_contract": ["validated_evidence", "tier2_supported", "candidate_rx_otc_value"],
      "uses_item_json_spread": true,
      "error_behavior": "P3 → validation_passed=false"
    },
    {
      "node_name": "Rx — Conflict Resolver",
      "purpose": "Apply acceptance/conflict matrix. Retain Sem baseline as provenance. No silent overwrite.",
      "input_contract": ["all validated_evidence", "read_only_provenance"],
      "output_contract": ["outcome", "conflict_status", "selected_evidence", "candidate_rx_otc_value", "final_rx_otc_value"],
      "uses_item_json_spread": true,
      "error_behavior": "P1/P1 → conflict non-retryable"
    },
    {
      "node_name": "Art — Build Audit Result",
      "purpose": "Stable result object for webhook + CSV. proposed_rx_otc unset in M3.2. P2-only keeps final_rx_otc_value=null.",
      "input_contract": ["identity", "query_plan", "validated_evidence", "outcome"],
      "output_contract": ["audit_result", "candidate_rx_otc_value", "final_rx_otc_value", "outcome", "logical_search_query_count", "transport_retry_attempt_count", "fetched_page_count", "budget_exhausted"],
      "uses_item_json_spread": true,
      "error_behavior": "always produce a result"
    },
    {
      "node_name": "Art — Write Audit Artifacts",
      "purpose": "Append M3.2 CSV/JSONL. No Postgres.",
      "input_contract": ["audit_result", "raw pointers"],
      "output_contract": ["artifact_paths"],
      "uses_item_json_spread": true,
      "error_behavior": "write fail → error; do not snapshot"
    },
    {
      "node_name": "Log — Optional Future Log Payload",
      "purpose": "Build product_classification_log shape only. M3.2 does not INSERT.",
      "input_contract": ["audit_result", "run_id", "attempt_history"],
      "output_contract": ["future_log_payload"],
      "uses_item_json_spread": true,
      "error_behavior": "omit payload rather than invent run_id=null"
    },
    {
      "node_name": "Fin — Finish Run",
      "purpose": "Webhook response + counts. No classification_runs update in M3.2a/b until approved.",
      "input_contract": ["all items"],
      "output_contract": ["run_id", "outcomes", "isolation_confirmation", "logical_search_query_count", "transport_retry_attempt_count", "fetched_page_count", "budget_exhausted_count"],
      "uses_item_json_spread": true,
      "error_behavior": "still return isolation flags"
    }
  ],
  "n8n_rules": {
    "item_spread": "...item.json",
    "structured_output_parser_mandatory": false,
    "one_run_id_all_attempts": true,
    "parse_validate_decide_preserve_provenance_after_external_steps": true,
    "m3_2_snapshot_update": false
  },
  "m3_2_review_schema": {
    "expected_rx_otc_manual": ["rx", "otc", "unknown", ""],
    "expected_rx_otc_source": "string_or_empty",
    "review_label_inconsistency": ["true", "false", ""],
    "leave_empty_for_future_human_review": true,
    "do_not_rewrite_historic_labels": true,
    "product_19198_seed": {
      "review_label_inconsistency": true,
      "expected_rx_otc_manual": "",
      "expected_rx_otc_source": ""
    }
  },
  "m3_2_controlled_batch_summary_required_counts": [
    "logical_search_query_count",
    "transport_retry_attempt_count",
    "fetched_page_count",
    "budget_exhausted_count"
  ],
  "search_query_count_alias_of": "logical_search_query_count"
}
