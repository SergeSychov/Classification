# n8n instance
N8N_URL=https://n8n.sychovtest.ru
N8N_API_KEY=

# Polza.ai (OpenAI-compatible aggregator for Judge / Qwen tests)
POLZA_API_KEY=
# POLZA_BASE_URL=https://polza.ai/api/v1

# DashScope / Alibaba Model Studio (Singapore / dashscope-intl) — MNN tool-search bakeoff
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# DeepSeek official API — MNN tool-search bakeoff + balance
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Serper.dev Google search — shared web_search tool for bakeoff
# If empty, scripts/mnn_tool_search_bakeoff.py falls back to DuckDuckGo Lite HTML
SERPER_API_KEY=

# Webhook path for classification-stage2-dev (optional override)
# N8N_STAGE2_WEBHOOK_PATH=classification-stage2-dev
